# ── Weiterleitungen und Fehlerseite ──────────────────────────────────────
# Reihenfolge ist entscheidend: erst die bekannten Umzuege, dann erst die
# Auffangregel. Andersherum verschluckt die Fehlerseite jede Weiterleitung.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Immer verschluesselt, immer ohne www — eine Adresse, nicht vier.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.energie-studio\.ch$ [NC]
  RewriteRule ^(.*)$ https://energie-studio.ch/$1 [R=301,L]

  # Die einzige Adresse der alten WordPress-Seite, die Google kennt.
  # Fuehrender Schraegstrich: zeigt auf die Domainwurzel. Greift deshalb
  # erst, wenn die Seite dort liegt — im Vorschau-Unterordner nicht.
  RewriteRule ^impressum-datenschutz/?$ /impressum.html [R=301,L]

  # Reste der alten Installation laufen auf die Startseite statt ins Leere.
  RewriteRule ^(wp-content|wp-includes|wp-json|feed|comments)(/.*)?$ / [R=301,L]
</IfModule>

# Keine Auffangregel per Umschreibung: die wuerde die Fehlerseite mit dem
# Status 200 ausliefern ("weiche 404"), und Suchmaschinen werten das ab.
# ErrorDocument liefert korrekt 404 mit.
ErrorDocument 404 /404.html

# Energie Studio — Serverregeln
# Gilt auf Apache. Laeuft die Seite hinter reinem nginx, greift diese Datei
# nicht; dann muessen Ablaufzeiten und Weiterleitung dort gesetzt werden.

# ── Ablaufzeiten ─────────────────────────────────────────────────────────
# Bilder, Schriften und Filmbilder aendern sich nie — sie tragen bei
# Aenderungen einen neuen Namen. HTML bleibt kurz, damit Korrekturen
# schnell ankommen.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 10 minutes"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|svg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
  # Grundlegender Schutz, ohne die Seite einzuschraenken
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ── Kompression ──────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  # "text/javascript" nicht vergessen: die meisten Server melden Skripte so,
  # und ohne diesen Eintrag gehen sie unkomprimiert raus — das waren hier
  # 120 KB zu viel.
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml application/xml
</IfModule>

# ── Verzeichnisse nicht auflisten ────────────────────────────────────────
Options -Indexes
